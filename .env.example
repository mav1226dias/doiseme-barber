# APP_URL: URL pública onde a aplicação está hospedada (ex: https://seu-dominio.vercel.app)
APP_URL="http://localhost:3000"

# Origens adicionais permitidas no CORS/CSRF em produção (separadas por vírgula)
TRUSTED_ORIGINS=""

# Ambiente ("development" ou "production")
NODE_ENV="development"

# Supabase (Frontend - Vite: apenas URL e chave pública anon — NUNCA coloque service_role aqui!)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase (Backend - Server-side Admin)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Chave privada (Service Role) para bypass de RLS no servidor — OBRIGATÓRIO em produção com RLS ativo
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Autenticação JWT (OBRIGATÓRIO em produção — gere uma string aleatória com >= 32 caracteres)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Senha inicial para bootstrap de contas Master em ambientes vazios (nunca deixe em código-fonte)
MASTER_BOOTSTRAP_PASSWORD=""

# WhatsApp do Suporte para Recuperação de Senha (Opcional — também editável no Painel Master)
SUPPORT_WHATSAPP="5511999999999"

# Pagamentos SaaS - Mercado Pago & PIX (Opcional — também configurável via Painel Master UI)
MP_ACCESS_TOKEN=""
MP_PIX_KEY=""
# Segredo do Webhook do Mercado Pago para validação HMAC x-signature (Recomendado em produção)
MP_WEBHOOK_SECRET=""

# Automação WhatsApp - Evolution API v2 (Opcional — também configurável via Painel Master UI)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
CRON_SECRET=""
